UM_EMAIL=
UM_PASSWORD=
# Preferred DB config: copy cypress/config/dbConfig.example.json to dbConfig.local.json.
# These environment values remain a fallback when no local JSON value is present.
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_DATABASE=core
DB_SSL=true
DB_TLS_REJECT_UNAUTHORIZED=true
# Set only if CI uses a private CA. Keep certificate files outside version control.
DB_CA_FILE=
